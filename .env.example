# Скопируй в .env и заполни. На VPS лежит в /var/www/neft/.env
# ВАЖНО: NODE_ENV и NODE_EXTRA_CA_CERTS живут в ecosystem.config.js (env-блок),
# НЕ здесь — Node читает их при старте процесса, plain `pm2 restart` их из .env не подхватит.

# --- Ядро ---
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me-long-random-string
APP_URL=https://texzakaz.ru
CORS_ORIGIN=

# --- Email (SMTP, nodemailer) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@texzakaz.ru

# --- Файлы: S3/Cloudflare R2 (prod) или локально в uploads/ если пусто ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- AI: генерация ТЗ/КП (lib/ai-client.js, OpenAI-compatible) ---
# Провайдер на проде: GigaChat (Sber). Groq заблокирован из РФ (403).
# Для GigaChat нужен NODE_EXTRA_CA_CERTS=certs/russian_trusted_root_ca.pem (в ecosystem.config.js).
AI_TZ_PROVIDER=gigachat
AI_TZ_API_KEY=
AI_TZ_BASE_URL=
AI_TZ_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Легаси-фолбэки (используются, если AI_TZ_* не заданы)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Классификация поисковых запросов в админском SEO-разделе. Часто не работает
# из РФ, поэтому ничего пользовательского на нём не висит: умный поиск по
# каталогу и генерация ТЗ идут через AI_TZ_* (GigaChat).
GEMINI_API_KEY=
# Отладка сырых ответов AI в логи
AI_DEBUG_RAW=

# --- Telegram-бот (telegram-bot.js) ---
# ВНИМАНИЕ: с VPS api.telegram.org недоступен (блокировка) — нужен split-tunnel
# AmneziaWG (только CIDR Телеграма через VPN). Без токена бот тихо выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@texzakaz.ru

# --- OAuth Яндекс ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

# --- Карты ---
MAP_PROVIDER=yandex
YANDEX_MAPS_API_KEY=

# --- Расчёт доставки (lib/logistics) ---
# ПЭК ключа не требует: у него публичный API без регистрации.
# Деловые Линии — бесплатный appKey с регистрации на dev.dellin.ru.
# Без ключа модуль ДЛ молча выпадает из расчёта, остальные считают как обычно.
DELLIN_APP_KEY=

# Возовоз — ключ из личного кабинета на vozovoz.ru. Ведёт себя так же:
# нет ключа — нет этого перевозчика в выдаче, расчёт не ломается.
VOZOVOZ_TOKEN=
# Демо-сервер их API с отдельным публичным ключом из документации
# (github.com/vozovoz/apiv2). Тарифы там тестовые, для проверки формата.
# Пусто — работаем с боевым https://vozovoz.ru/api/
VOZOVOZ_API_URL=

# --- Мониторинг ---
SENTRY_DSN=
# Куда писать о поломках, которые должен увидеть не пользователь, а мы:
# недельная проверка API перевозчиков (lib/logistics/health.js).
# Шлём и в Sentry, и сюда — оба канала необязательные, но если не задан ни один,
# тревога останется только в логе pm2, то есть её не увидит никто.
OPS_EMAIL=

# --- Реестр ГИСП: авто-инвайты заводам при новой закупке ---
# 0 = выключить (ОБЯЗАТЕЛЬНО при ручных тестах на проде — иначе письма реальным заводам!)
REGISTRY_INVITES_ENABLED=

# --- Маркетинговая рассылка заводам (scripts/outreach.js) ---
# Почта для ответов заводов (Reply-To). Без неё --send откажется работать.
OUTREACH_REPLY_TO=

# --- Сид/сервисное (только dev) ---
SEED_ADMIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_DATA=
GEOCODE_ON_START=

# Компании тестовых учёток: их закупки не уходят в сообщество ВК
TEST_CUSTOMER_COMPANY=
TEST_PRODUCER_COMPANY=

# Учётки для e2e-прогонов playwright: под ними тесты входят на стенд
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=

# Автопостинг закупок в сообщество ВКонтакте
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_AUTOPOST_ENABLED=0

# Подсказки адресов в расчёте доставки (dadata.ru, 10 000 в сутки бесплатно).
# Нужен только ключ подсказок. Секретный ключ — для платной стандартизации,
# она здесь не используется, и хранить его не надо.
DADATA_API_KEY=

# Поисковые консоли: снятие позиций и запросов в админском SEO-разделе.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SITE_URL=
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_HOST_ID=

# Необязательные настройки с рабочими значениями по умолчанию —
# задавать только если нужно отойти от умолчания.
AI_DRAWING_MODEL=      # модель разбора чертежа, по умолчанию GigaChat-2-Max
MAX_VIDEO_MB=          # потолок видео в профиле, по умолчанию 200
VK_API_VERSION=        # версия API ВКонтакте, по умолчанию 5.199
VK_POST_INTERVAL_MS=   # пауза между постами в ВК

# Только для разработки и тестов, на проде не нужны.
E2E_BASE_URL=          # против какого адреса гнать playwright
MVP_SMOKE_BASE_URL=
MVP_SMOKE_RUN=         # 1 — прогнать смоук API
MOCK_DENSITY=          # плотность подставных данных в юнитах
NO_WEBGL=              # 1 — отключить WebGL в тестах карты

# NODE_ENV здесь намеренно нет: на проде он задаётся в ecosystem.config.js,
# чтобы пережить любые правки .env (см. README, раздел про деплой).
